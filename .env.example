REDCAP_BRISK_API_URL=https://redcap.example.edu/api/
REDCAP_BRISK_API_TOKEN=replace-with-the-brisk-project-api-token

REDCAP_PRISM_API_URL=https://redcap.example.edu/api/
REDCAP_PRISM_API_TOKEN=replace-with-the-prism-project-api-token

REDCAP_TRAIN_API_URL=https://redcap.example.edu/api/
REDCAP_TRAIN_API_TOKEN=replace-with-the-train-project-api-token

REDCAP_TIMEOUT_SECONDS=20
REDCAP_CACHE_TTL_SECONDS=600
REDCAP_REFERENCE_CACHE_TTL_SECONDS=86400

# Optional local-only persistent cache controls. Direct python app.py runs
# default to prefer, which seeds missing project files once and then never
# bypasses them, even when the dashboard Refresh button is used.
# APLUS_DEV_CACHE_MODE=prefer
# APLUS_DEV_CACHE_DIR=.dev-cache
